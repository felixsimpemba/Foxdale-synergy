APP_NAME="Foxdale Synergy"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=foxdale_incidents
DB_USERNAME=foxdale
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

SANCTUM_EXPIRATION=480
# The web app's public address: used for CORS, email links and push notification links.
FRONTEND_URL=http://localhost:3000

# Incident defaults. The display timezone is used for reports, business days and schedules.
INCIDENTS_DISPLAY_TIMEZONE=Africa/Lusaka
# Team that receives incidents no routing rule matches.
INCIDENTS_DEFAULT_TEAM=NOC
# Private disk for uploaded documents and comment attachments.
INCIDENTS_UPLOAD_DISK=local
INCIDENTS_VIRUS_SCANNER=none

# AI suggestions (leave off until an Anthropic key is configured).
AI_ENABLED=false
# ANTHROPIC_API_KEY=
# AI_MODEL=

VAPID_SUBJECT=mailto:noc@foxdale.local
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
